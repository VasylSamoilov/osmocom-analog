def test_compute_impulse_response_integration():
    """Integration test: compute impulse response from realistic echo scenario."""
    sample_rate = 8000
    duration_s = 2.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal (more complex than simple sine)
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.3 * np.sin(2 * np.pi * 440 * t) + 0.2 * np.sin(2 * np.pi * 880 * t)
    
    # Create RX signal with realistic echo path:
    # - Primary echo at 15ms with 0.25 amplitude
    # - Secondary reflection at 45ms with 0.12 amplitude
    # - Background noise
    rx_signal = np.zeros_like(tx_signal)
    
    delay1 = int(0.015 * sample_rate)  # 15ms
    rx_signal[delay1:] += 0.25 * tx_signal[:-delay1]
    
    delay2 = int(0.045 * sample_rate)  # 45ms
    rx_signal[delay2:] += 0.12 * tx_signal[:-delay2]
    
    # Add noise
    rx_signal += np.random.randn(len(rx_signal)) * 0.02
    
    # Analyze
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    impulse_response, tail_length_ms, peaks = analyzer.compute_impulse_response(max_length_ms=100)
    
    # Verify results
    assert len(impulse_response) > 0, "Should compute impulse response"
    assert tail_length_ms > 0, "Should detect echo tail"
    assert len(peaks) >= 1, "Should detect at least primary echo"
    
    # Primary peak should be near 15ms
    peak_delays = [d for d, _ in peaks]
    assert any(12 < d < 18 for d in peak_delays), "Should detect primary echo near 15ms"
    
    # Tail should extend beyond the secondary reflection
    assert tail_length_ms > 40, f"Tail should extend beyond 40ms, got {tail_length_ms:.1f}ms"
    
    print("✓ test_compute_impulse_response_integration passed")


def test_compute_frequency_response_basic():
    """Test basic frequency response computation from impulse response."""
    sample_rate = 8000
    duration_s = 1.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal (sine wave)
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # Create RX signal with known echo
    delay_samples = 100
    rx_signal = np.zeros_like(tx_signal)
    rx_signal[delay_samples:] = 0.3 * tx_signal[:-delay_samples]
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # First compute impulse response
    impulse_response, _, _ = analyzer.compute_impulse_response(max_length_ms=100)
    
    # Then compute frequency response
    freq_response = analyzer.compute_frequency_response(impulse_response)
    
    # Verify frequency response is returned
    assert freq_response is not None, "Frequency response should not be None"
    assert len(freq_response) > 0, "Frequency response should not be empty"
    
    # Verify format: list of (freq_hz, magnitude_db) tuples
    for freq_hz, magnitude_db in freq_response:
        assert isinstance(freq_hz, float), "Frequency should be float"
        assert isinstance(magnitude_db, float), "Magnitude should be float"
        assert freq_hz >= 0, "Frequency should be non-negative"
    
    # Verify frequencies are sorted
    freqs = [f for f, _ in freq_response]
    assert freqs == sorted(freqs), "Frequencies should be sorted"
    
    # Verify frequency range: 0 to Nyquist (sample_rate / 2)
    nyquist = sample_rate / 2.0
    assert freqs[0] == 0.0, "First frequency should be 0 Hz (DC)"
    assert freqs[-1] <= nyquist, f"Last frequency should be <= Nyquist ({nyquist} Hz)"
    
    # Verify magnitudes are in dB (reasonable range)
    magnitudes = [m for _, m in freq_response]
    assert all(-200 < m < 200 for m in magnitudes), "Magnitudes should be in reasonable dB range"
    
    print("✓ test_compute_frequency_response_basic passed")


