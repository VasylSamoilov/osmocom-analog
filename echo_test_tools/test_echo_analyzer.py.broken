def test_estimate_convergence_custom_threshold():
    """Test convergence with custom threshold percentage."""
    # ERL goes from 10 to 20 dB
    erl_series = [
        (50.0, 10.0),
        (100.0, 12.0),
        (150.0, 14.0),
        (200.0, 16.0),   # 80% of 20 = 16
        (250.0, 18.0),   # 90% of 20 = 18
        (300.0, 20.0),
    ]
    
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Test with 80% threshold
    conv_time_80, converged_80 = analyzer.estimate_convergence(erl_series, threshold_percent=80)
    assert converged_80 is True, "Should converge at 80% threshold"
    assert 180 < conv_time_80 < 220, f"Expected convergence around 200ms, got {conv_time_80}ms"
    
    # Test with 90% threshold
    conv_time_90, converged_90 = analyzer.estimate_convergence(erl_series, threshold_percent=90)
    assert converged_90 is True, "Should converge at 90% threshold"
    assert 230 < conv_time_90 < 270, f"Expected convergence around 250ms, got {conv_time_90}ms"
    
    # 90% threshold should converge later than 80%
    assert conv_time_90 > conv_time_80, "Higher threshold should converge later"
    
    print("✓ test_estimate_convergence_custom_threshold passed")


def test_estimate_convergence_with_noise():
    """Test convergence detection with noisy ERL measurements."""
    # ERL converges from 8 to 24 dB with noise
    # 90% of 24 = 21.6 dB
    erl_series = [
        (50.0, 8.2),
        (100.0, 10.5),
        (150.0, 12.1),
        (200.0, 14.8),
        (250.0, 17.2),
        (300.0, 19.5),
        (350.0, 21.8),   # First time >= 21.6 dB
        (400.0, 22.3),
        (450.0, 23.8),
        (500.0, 24.2),
        (550.0, 23.9),
        (600.0, 24.1),
    ]
    
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    conv_time, converged = analyzer.estimate_convergence(erl_series, threshold_percent=90)
    
