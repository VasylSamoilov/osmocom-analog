def test_compute_frequency_response_frequency_coverage():
    """Test that frequency response covers 0 to Nyquist."""
    sample_rate = 8000
    duration_s = 0.5
    n_samples = int(sample_rate * duration_s)
    
    # Create test signals
    tx_signal = np.random.randn(n_samples) * 0.5
    rx_signal = np.random.randn(n_samples) * 0.1
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Compute impulse response
    impulse_response, _, _ = analyzer.compute_impulse_response(max_length_ms=50)
    
    # Compute frequency response
    freq_response = analyzer.compute_frequency_response(impulse_response)
    
    assert len(freq_response) > 0, "Should return frequency response"
    
    # Extract frequencies
    freqs = [f for f, _ in freq_response]
    
    # Verify coverage
    nyquist = sample_rate / 2.0
    assert freqs[0] == 0.0, "Should start at 0 Hz"
    assert freqs[-1] <= nyquist, f"Should end at or before Nyquist ({nyquist} Hz)"
    
    # Verify reasonable frequency resolution
    # For 50ms impulse (400 samples at 8kHz), we should have ~200 frequency bins
    assert len(freqs) > 50, f"Should have reasonable frequency resolution, got {len(freqs)} bins"
    
    print("✓ test_compute_frequency_response_frequency_coverage passed")


def test_compute_frequency_response_magnitude_scale():
    """Test that magnitudes are in dB scale."""
    sample_rate = 8000
    duration_s = 0.5
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # Create RX with echo
    delay_samples = 100
    rx_signal = np.zeros_like(tx_signal)
    rx_signal[delay_samples:] = 0.3 * tx_signal[:-delay_samples]
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Compute impulse response
    impulse_response, _, _ = analyzer.compute_impulse_response(max_length_ms=50)
    
    # Compute frequency response
    freq_response = analyzer.compute_frequency_response(impulse_response)
    
    # Extract magnitudes
    magnitudes = [m for _, m in freq_response]
    
    # Magnitudes should be in dB (typically negative for attenuation)
    # Check that they're in a reasonable range
    assert all(-200 < m < 100 for m in magnitudes), "Magnitudes should be in reasonable dB range"
    
    # The peak magnitude should be finite (not inf or -inf)
    max_magnitude = max(magnitudes)
    min_magnitude = min(magnitudes)
    assert np.isfinite(max_magnitude), "Max magnitude should be finite"
    assert np.isfinite(min_magnitude), "Min magnitude should be finite"
    
    print("✓ test_compute_frequency_response_magnitude_scale passed")


def test_compute_frequency_response_integration():
    """Integration test: compute impulse response then frequency response."""
    sample_rate = 8000
    duration_s = 1.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal with multiple frequency components
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = (0.3 * np.sin(2 * np.pi * 300 * t) +
                 0.3 * np.sin(2 * np.pi * 800 * t) +
                 0.3 * np.sin(2 * np.pi * 1500 * t))
    
    # Create RX with echo
    delay_samples = 100
    rx_signal = np.zeros_like(tx_signal)
    rx_signal[delay_samples:] = 0.25 * tx_signal[:-delay_samples]
    
    # Add small noise
    rx_signal += np.random.randn(len(rx_signal)) * 0.01
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Compute impulse response
    impulse_response, tail_length_ms, peaks = analyzer.compute_impulse_response(max_length_ms=100)
    
    assert len(impulse_response) > 0, "Should compute impulse response"
    assert len(peaks) > 0, "Should detect peaks"
    
    # Compute frequency response
    freq_response = analyzer.compute_frequency_response(impulse_response)
    
    assert len(freq_response) > 0, "Should compute frequency response"
    
    # Verify the frequency response has reasonable characteristics
    freqs = [f for f, _ in freq_response]
    magnitudes = [m for _, m in freq_response]
    
    # Should cover 0 to Nyquist
    assert freqs[0] == 0.0, "Should start at DC"
    assert freqs[-1] <= sample_rate / 2.0, "Should end at or before Nyquist"
    
    # Should have finite magnitudes
    assert all(np.isfinite(m) for m in magnitudes), "All magnitudes should be finite"
    
    print("✓ test_compute_frequency_response_integration passed")


def test_compute_frequency_response_validates_requirement_4a4():
    """Test that compute_frequency_response validates Requirement 4a.4."""
    # Requirement 4a.4: THE Echo_Analyzer SHALL compute frequency response of the echo path
    
    sample_rate = 8000
    duration_s = 0.5
    n_samples = int(sample_rate * duration_s)
    
    # Create test signals
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    delay_samples = 100
    rx_signal = np.zeros_like(tx_signal)
    rx_signal[delay_samples:] = 0.3 * tx_signal[:-delay_samples]
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Compute impulse response (prerequisite)
    impulse_response, _, _ = analyzer.compute_impulse_response()
    
    # Compute frequency response - this is the requirement being validated
    freq_response = analyzer.compute_frequency_response(impulse_response)
    
    # Verify the requirement is met:
    # 1. Method exists and is callable
    assert hasattr(analyzer, 'compute_frequency_response'), "Method should exist"
    assert callable(analyzer.compute_frequency_response), "Method should be callable"
    
    # 2. Returns list of (freq_hz, magnitude_db) tuples
    assert isinstance(freq_response, list), "Should return a list"
    assert len(freq_response) > 0, "Should return non-empty list"
    
    for item in freq_response:
        assert isinstance(item, tuple), "Each item should be a tuple"
        assert len(item) == 2, "Each tuple should have 2 elements"
        freq_hz, magnitude_db = item
        assert isinstance(freq_hz, float), "Frequency should be float"
        assert isinstance(magnitude_db, float), "Magnitude should be float"
    
    # 3. Covers frequencies from 0 to Nyquist
    freqs = [f for f, _ in freq_response]
    assert freqs[0] == 0.0, "Should start at 0 Hz"
    assert freqs[-1] <= sample_rate / 2.0, "Should end at Nyquist"
    
    # 4. Magnitudes are in dB
    magnitudes = [m for _, m in freq_response]
    # dB values should be in a reasonable range (not raw linear magnitudes)
    assert all(-200 < m < 100 for m in magnitudes), "Magnitudes should be in dB scale"
    
    print("✓ test_compute_frequency_response_validates_requirement_4a4 passed")


def test_compute_frequency_response_different_lengths():
    """Test frequency response with different impulse response lengths."""
    sample_rate = 8000
    tx_signal = np.random.randn(1000) * 0.5
    rx_signal = np.random.randn(1000) * 0.1
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Test with different impulse response lengths
    for length in [10, 50, 100, 500]:
        impulse_response = np.random.randn(length) * 0.1
        freq_response = analyzer.compute_frequency_response(impulse_response)
        
        assert len(freq_response) > 0, f"Should return frequency response for length {length}"
        
        # Number of frequency bins should be related to impulse response length
        # For fftfreq with positive frequencies only: floor(N/2) + 1 for even N, ceil(N/2) for odd N
        # Simpler: just verify we get approximately half the bins (positive frequencies)
        expected_bins_min = length // 2
        expected_bins_max = (length // 2) + 2  # Allow some tolerance
        assert expected_bins_min <= len(freq_response) <= expected_bins_max, \
            f"Expected ~{length//2} bins for length {length}, got {len(freq_response)}"
    
    print("✓ test_compute_frequency_response_different_lengths passed")


def test_cli_efficiency_flag():
    """Test that CLI --efficiency flag works correctly."""
    import subprocess
    import tempfile
    import os
    
    # Create temporary JSON output file
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        json_path = f.name
    
    try:
        # Run CLI with --efficiency flag
        result = subprocess.run(
            [
                'python3', 'echo_test_tools/echo_analyzer.py',
                '--tx', 'echo_test_tools/efficiency_test_signal.wav',
                '--rx', 'echo_test_tools/test_rx_synthetic.wav',
                '--efficiency',
                '--json', json_path
            ],
            capture_output=True,
            text=True,
            timeout=10
        )
        
        # Check that command succeeded
        assert result.returncode == 0, f"CLI failed with: {result.stderr}"
        
        # Check that output contains efficiency metrics
        assert "ERLE" in result.stdout, "Output should contain ERLE"
        assert "Convergence Time" in result.stdout, "Output should contain convergence time"
        assert "Residual Echo Power" in result.stdout, "Output should contain residual echo"
        assert "AEC Performance" in result.stdout, "Output should contain AEC performance"
        
        # Check that JSON file was created
        assert os.path.exists(json_path), "JSON file should be created"
        
        # Load and verify JSON content
        import json
        with open(json_path, 'r') as f:
            data = json.load(f)
        
        # Verify efficiency fields are present
        assert "erle_db" in data, "JSON should contain erle_db"
        assert "convergence_time_ms" in data, "JSON should contain convergence_time_ms"
        assert "residual_echo_dbfs" in data, "JSON should contain residual_echo_dbfs"
        assert "aec_performance" in data, "JSON should contain aec_performance"
        assert "converged" in data, "JSON should contain converged"
        assert "erl_time_series" in data, "JSON should contain erl_time_series"
        
        # Verify base fields are also present
        assert "delay_samples" in data, "JSON should contain delay_samples"
        assert "erl_db" in data, "JSON should contain erl_db"
        
        print("✓ test_cli_efficiency_flag passed")
        
    finally:
        # Clean up temporary file
        if os.path.exists(json_path):
            os.unlink(json_path)


def test_cli_basic_mode():
    """Test that CLI basic mode (without --efficiency) still works."""
    import subprocess
    import tempfile
    import os
    
    # Create temporary JSON output file
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        json_path = f.name
    
    try:
        # Run CLI without --efficiency flag
        result = subprocess.run(
            [
                'python3', 'echo_test_tools/echo_analyzer.py',
                '--tx', 'echo_test_tools/echo_test_signal.wav',
                '--rx', 'echo_test_tools/test_rx_synthetic.wav',
                '--json', json_path
            ],
            capture_output=True,
            text=True,
            timeout=10
        )
        
        # Check that command succeeded
        assert result.returncode == 0, f"CLI failed with: {result.stderr}"
        
        # Check that output does NOT contain efficiency metrics
        assert "ERLE" not in result.stdout, "Basic output should not contain ERLE"
        assert "Convergence Time" not in result.stdout, "Basic output should not contain convergence"
        
        # Check that output contains basic metrics
        assert "Echo Return Loss (ERL)" in result.stdout, "Output should contain ERL"
        assert "Echo Delay" in result.stdout, "Output should contain delay"
        
        # Check that JSON file was created
        assert os.path.exists(json_path), "JSON file should be created"
        
        # Load and verify JSON content
        import json
        with open(json_path, 'r') as f:
            data = json.load(f)
        
        # Verify basic fields are present
        assert "delay_samples" in data, "JSON should contain delay_samples"
        assert "erl_db" in data, "JSON should contain erl_db"
        assert "correlation_peak" in data, "JSON should contain correlation_peak"
        
        # Verify efficiency fields are NOT present (basic mode)
        assert "erle_db" not in data, "Basic JSON should not contain erle_db"
        assert "convergence_time_ms" not in data, "Basic JSON should not contain convergence_time_ms"
        
        print("✓ test_cli_basic_mode passed")
        
    finally:
        # Clean up temporary file
        if os.path.exists(json_path):
            os.unlink(json_path)


