def test_classify_aec_performance_boundary_values():
    """Test exact boundary values for classification thresholds."""
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Test exact boundaries according to requirements:
    # - "excellent" if ERLE > 25 dB
    # - "good" if ERLE > 20 dB (and <= 25)
    # - "moderate" if ERLE > 6 dB (and <= 20)
    # - "poor" if ERLE <= 6 dB
    
    # Boundary at 6 dB
    assert analyzer.classify_aec_performance(6.0) == "poor", "6.0 dB should be poor (<=6)"
    assert analyzer.classify_aec_performance(6.01) == "moderate", "6.01 dB should be moderate (>6)"
    
    # Boundary at 20 dB
    assert analyzer.classify_aec_performance(20.0) == "moderate", "20.0 dB should be moderate (<=20)"
    assert analyzer.classify_aec_performance(20.01) == "good", "20.01 dB should be good (>20)"
    
    # Boundary at 25 dB
    assert analyzer.classify_aec_performance(25.0) == "good", "25.0 dB should be good (<=25)"
    assert analyzer.classify_aec_performance(25.01) == "excellent", "25.01 dB should be excellent (>25)"
    
    print("✓ test_classify_aec_performance_boundary_values passed")


