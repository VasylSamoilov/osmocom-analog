    assert tail_length_ms >= 0, "Tail length should be non-negative"
    
    # May or may not detect peaks depending on noise
    # Just verify the format is correct
    for delay_ms, amplitude in peaks:
        assert delay_ms >= 0, "Peak delay should be non-negative"
