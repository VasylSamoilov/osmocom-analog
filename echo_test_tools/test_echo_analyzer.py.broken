    assert conv_time is not None, "Convergence time should not be None"
    assert 320 < conv_time < 380, f"Expected convergence around 350ms, got {conv_time}ms"
    
    print("✓ test_estimate_convergence_with_noise passed")


def test_estimate_convergence_slow_convergence():
    """Test convergence detection with very slow convergence."""
    # ERL improves very slowly from 5 to 25 dB over long time
    # 90% of 25 = 22.5 dB
    erl_series = []
    for i in range(50):
        time_ms = i * 100
        erl_db = 5 + (20 * i / 49)  # Linear from 5 to 25
        erl_series.append((time_ms, erl_db))
    
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    conv_time, converged = analyzer.estimate_convergence(erl_series, threshold_percent=90)
    
    assert converged is True, "Should detect slow convergence"
    assert conv_time is not None, "Convergence time should not be None"
    
    # 22.5 dB is reached at i = (22.5 - 5) / 20 * 49 = 42.875, so around 4300ms
    # But the final value is computed from last 20% (last 10 samples), which averages slightly less than 25
    # So the actual threshold might be slightly lower, causing earlier convergence
    assert 3800 < conv_time < 4500, f"Expected convergence around 4000-4300ms, got {conv_time}ms"
    
    print("✓ test_estimate_convergence_slow_convergence passed")


def test_estimate_convergence_realistic_pattern():
    """Test with realistic AEC convergence pattern."""
    # Simulate realistic AEC: fast initial improvement, then gradual refinement
    erl_series = []
    
    # Phase 1 (0-500ms): Rapid improvement from 6 to 18 dB
    for i in range(5):
        time_ms = i * 100
        erl_db = 6 + (12 * i / 4)
        erl_series.append((time_ms, erl_db))
    
    # Phase 2 (500-1500ms): Slower improvement from 18 to 22 dB
    for i in range(10):
        time_ms = 500 + i * 100
        erl_db = 18 + (4 * i / 9)
        erl_series.append((time_ms, erl_db))
    
    # Phase 3 (1500-3000ms): Stable at 22 dB
    for i in range(15):
        time_ms = 1500 + i * 100
        erl_series.append((time_ms, 22.0 + np.random.randn() * 0.3))
    
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # 90% of 22 = 19.8 dB
    conv_time, converged = analyzer.estimate_convergence(erl_series, threshold_percent=90)
    
    assert converged is True, "Should detect convergence"
    assert conv_time is not None, "Convergence time should not be None"
    
    # Should converge somewhere in phase 2 when ERL reaches ~19.8 dB
    assert 500 < conv_time < 1500, f"Expected convergence in phase 2, got {conv_time}ms"
    
    print("✓ test_estimate_convergence_realistic_pattern passed")


def test_estimate_convergence_integration():
    """Integration test: ERL time series -> convergence detection."""
    sample_rate = 8000
    duration_s = 3.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # Create RX signal that simulates AEC convergence
    # Attenuation improves from 0.3 (early) to 0.05 (late)
    delay_samples = 100
    rx_signal = np.zeros_like(tx_signal)
    
    for i in range(len(tx_signal) - delay_samples):
        progress = i / (len(tx_signal) - delay_samples)
        # Exponential convergence (more realistic)
        attenuation = 0.05 + 0.25 * np.exp(-5 * progress)
        rx_signal[i + delay_samples] = attenuation * tx_signal[i]
    
    # Add noise
    rx_signal += np.random.randn(len(rx_signal)) * 0.01
    
    # Analyze
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    erl_series = analyzer.calculate_erl_time_series(window_ms=100, overlap_ms=50)
    
    assert len(erl_series) > 0, "Should get ERL time series"
    
    # Detect convergence
    conv_time, converged = analyzer.estimate_convergence(erl_series, threshold_percent=90)
    
    assert converged is True, "Should detect convergence in simulated AEC"
    assert conv_time is not None, "Convergence time should not be None"
    
    # Convergence should occur somewhere in the middle of the signal
    assert 0 < conv_time < duration_s * 1000, f"Convergence time {conv_time}ms should be within signal duration"
    
    print("✓ test_estimate_convergence_integration passed")


def test_calculate_residual_echo_basic():
    """Test basic residual echo calculation after convergence."""
    sample_rate = 8000
    duration_s = 2.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal (sine wave)
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # Create RX signal with known residual echo level
    # After convergence (at 1 second), echo is attenuated to -30 dBFS
    delay_samples = 100
    rx_signal = np.zeros_like(tx_signal)
    
    convergence_sample = int(1.0 * sample_rate)  # 1 second
    
    # Before convergence: strong echo (0.1 = -20 dB)
    for i in range(convergence_sample):
        if i + delay_samples < len(rx_signal):
            rx_signal[i + delay_samples] = 0.1 * tx_signal[i]
    
    # After convergence: weak echo (0.03 = -30 dB)
    for i in range(convergence_sample, len(tx_signal)):
        if i + delay_samples < len(rx_signal):
            rx_signal[i + delay_samples] = 0.03 * tx_signal[i]
    
    # Add small noise
    rx_signal += np.random.randn(len(rx_signal)) * 0.001
    
    # Analyze
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    convergence_time_ms = 1000.0  # Known convergence at 1 second
    
    residual_echo = analyzer.calculate_residual_echo(delay_samples, convergence_time_ms)
    
    assert residual_echo is not None, "Residual echo should not be None"
    
    # Expected residual echo: 0.03 amplitude = -30.5 dBFS (20*log10(0.03))
    # Allow wider tolerance due to noise and RMS calculation over varying signal
    expected_dbfs = 20 * np.log10(0.03)
    assert expected_dbfs - 10 < residual_echo < expected_dbfs + 5, \
        f"Expected residual echo around {expected_dbfs:.1f} dBFS, got {residual_echo:.1f} dBFS"
    
    print("✓ test_calculate_residual_echo_basic passed")


def test_calculate_residual_echo_no_convergence():
    """Test that no convergence (None) returns None."""
    sample_rate = 8000
    n_samples = 8000
    
    tx_signal = np.random.randn(n_samples) * 0.5
