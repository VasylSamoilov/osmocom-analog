def test_compute_impulse_response_multiple_reflections():
    """Test detection of multiple echo reflections."""
    sample_rate = 8000
    duration_s = 1.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # Create RX signal with multiple reflections
    rx_signal = np.zeros_like(tx_signal)
    
    # Primary echo at 12.5ms (100 samples), amplitude 0.3
    delay1 = 100
    rx_signal[delay1:] += 0.3 * tx_signal[:-delay1]
    
    # Secondary reflection at 37.5ms (300 samples), amplitude 0.15
    delay2 = 300
    rx_signal[delay2:] += 0.15 * tx_signal[:-delay2]
    
    # Tertiary reflection at 62.5ms (500 samples), amplitude 0.08
    delay3 = 500
    rx_signal[delay3:] += 0.08 * tx_signal[:-delay3]
    
    # Add small noise
    rx_signal += np.random.randn(len(rx_signal)) * 0.01
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    impulse_response, tail_length_ms, peaks = analyzer.compute_impulse_response(max_length_ms=100)
    
    # Should detect multiple peaks
    assert len(peaks) >= 2, f"Should detect at least 2 peaks, got {len(peaks)}"
    
    # Verify peaks are at expected delays
    peak_delays = [d for d, _ in peaks]
    
    # First peak should be near 12.5ms
    assert any(10 < d < 15 for d in peak_delays), "Should detect primary echo near 12.5ms"
    
    # Second peak should be near 37.5ms
    assert any(35 < d < 40 for d in peak_delays), "Should detect secondary reflection near 37.5ms"
    
    # Tail length should extend to at least the last significant reflection
    assert tail_length_ms > 50, f"Tail length should extend beyond 50ms, got {tail_length_ms:.1f}ms"
    
    print("✓ test_compute_impulse_response_multiple_reflections passed")


def test_compute_impulse_response_tail_length():
    """Test echo tail length detection."""
    sample_rate = 8000
    duration_s = 1.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # Create RX signal with decaying echo (simulating reverb)
    rx_signal = np.zeros_like(tx_signal)
    
    # Add multiple decaying reflections
    for i in range(10):
        delay = 50 + i * 30  # Reflections every 30 samples (~3.75ms)
        amplitude = 0.3 * np.exp(-i * 0.5)  # Exponential decay
        if delay < len(tx_signal):
            rx_signal[delay:] += amplitude * tx_signal[:-delay]
    
    # Add noise
    rx_signal += np.random.randn(len(rx_signal)) * 0.01
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    impulse_response, tail_length_ms, peaks = analyzer.compute_impulse_response(max_length_ms=100)
    
    # Tail length should be positive and reasonable
    assert tail_length_ms > 0, "Tail length should be positive"
    assert tail_length_ms < 100, "Tail length should be within max_length_ms"
    
    # Should detect multiple peaks due to reflections
    assert len(peaks) >= 3, f"Should detect multiple peaks, got {len(peaks)}"
    
    print("✓ test_compute_impulse_response_tail_length passed")


def test_compute_impulse_response_custom_max_length():
    """Test with custom max_length_ms parameter."""
    sample_rate = 8000
    duration_s = 1.0
    n_samples = int(sample_rate * duration_s)
    
    # Create signals
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    delay_samples = 100
    rx_signal = np.zeros_like(tx_signal)
    rx_signal[delay_samples:] = 0.3 * tx_signal[:-delay_samples]
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Test with shorter max length
    impulse_response_short, _, _ = analyzer.compute_impulse_response(max_length_ms=50)
    
    # Test with longer max length
    impulse_response_long, _, _ = analyzer.compute_impulse_response(max_length_ms=200)
    
    # Verify lengths
    expected_short = int(50 * sample_rate / 1000)
    expected_long = int(200 * sample_rate / 1000)
    
    assert len(impulse_response_short) <= expected_short + 1, "Short impulse response should respect max_length"
    assert len(impulse_response_long) <= expected_long + 1, "Long impulse response should respect max_length"
    assert len(impulse_response_long) > len(impulse_response_short), "Longer max_length should give longer response"
    
    print("✓ test_compute_impulse_response_custom_max_length passed")


def test_compute_impulse_response_peak_amplitude():
    """Test that peak amplitude is near the detected echo delay."""
    sample_rate = 8000
    duration_s = 1.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # Create RX signal with known delay
    delay_samples = 100  # 12.5ms
    rx_signal = np.zeros_like(tx_signal)
    rx_signal[delay_samples:] = 0.4 * tx_signal[:-delay_samples]
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    impulse_response, tail_length_ms, peaks = analyzer.compute_impulse_response(max_length_ms=100)
    
    # Find the peak in the impulse response
    peak_idx = np.argmax(np.abs(impulse_response))
    peak_delay_ms = (peak_idx * 1000.0) / sample_rate
    
    # Peak should be near the known delay (12.5ms)
    assert 10 < peak_delay_ms < 15, f"Peak should be near 12.5ms, got {peak_delay_ms:.1f}ms"
    
    # The detected peaks should include this main peak
    assert len(peaks) > 0, "Should detect at least one peak"
    main_peak_delay, _ = peaks[0]
    assert abs(main_peak_delay - peak_delay_ms) < 5, "Detected peak should match impulse response peak"
    
    print("✓ test_compute_impulse_response_peak_amplitude passed")


