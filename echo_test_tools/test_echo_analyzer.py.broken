    # Create RX signal with realistic AEC convergence
    delay_samples = 100
    rx_signal = np.zeros_like(tx_signal)
    
    for i in range(len(tx_signal) - delay_samples):
        # Exponential convergence from 0.3 to 0.05
        progress = i / (len(tx_signal) - delay_samples)
        attenuation = 0.05 + 0.25 * np.exp(-5 * progress)
        rx_signal[i + delay_samples] = attenuation * tx_signal[i]
    
    # Add noise
