def test_calculate_residual_echo_early_convergence():
    """Test with early convergence (plenty of signal after)."""
    sample_rate = 8000
    duration_s = 2.0
    n_samples = int(sample_rate * duration_s)
    
    # Create signals
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # RX with constant low echo level
    delay_samples = 100
    rx_signal = np.zeros_like(tx_signal)
    rx_signal[delay_samples:] = 0.05 * tx_signal[:-delay_samples]
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Early convergence at 200ms
    convergence_time_ms = 200.0
    residual_echo = analyzer.calculate_residual_echo(delay_samples, convergence_time_ms)
    
    assert residual_echo is not None, "Residual echo should not be None"
    
    # Expected: 0.05 amplitude = -26 dBFS
    # But RMS of sine wave is amplitude/sqrt(2), so actual RMS power is lower
    # Allow wider tolerance
    expected_dbfs = 20 * np.log10(0.05)
    assert expected_dbfs - 10 < residual_echo < expected_dbfs + 5, \
        f"Expected residual echo around {expected_dbfs:.1f} dBFS, got {residual_echo:.1f} dBFS"
    
    print("✓ test_calculate_residual_echo_early_convergence passed")


def test_calculate_residual_echo_consistency_with_rx_power():
    """Test that residual echo is less than or equal to RX power."""
    sample_rate = 8000
    duration_s = 2.0
    n_samples = int(sample_rate * duration_s)
    
    # Create signals
    tx_signal = np.random.randn(n_samples) * 0.5
    rx_signal = np.random.randn(n_samples) * 0.1
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Calculate overall RX power
    rx_power_dbfs = analyzer.calculate_power_dbfs(rx_signal)
    
    # Calculate residual echo after convergence
    convergence_time_ms = 500.0
    residual_echo = analyzer.calculate_residual_echo(delay_samples=100, convergence_time_ms=convergence_time_ms)
    
    assert residual_echo is not None, "Residual echo should not be None"
    
    # Residual echo should be <= RX power (it's a portion of RX)
    # Allow small tolerance for measurement differences
    assert residual_echo <= rx_power_dbfs + 5, \
        f"Residual echo ({residual_echo:.1f} dBFS) should be <= RX power ({rx_power_dbfs:.1f} dBFS)"
    
    print("✓ test_calculate_residual_echo_consistency_with_rx_power passed")


def test_calculate_residual_echo_integration():
    """Integration test: full analysis pipeline including residual echo."""
    sample_rate = 8000
    duration_s = 3.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # Create RX signal with AEC convergence
    delay_samples = 100
    rx_signal = np.zeros_like(tx_signal)
    
    for i in range(len(tx_signal) - delay_samples):
        progress = i / (len(tx_signal) - delay_samples)
        attenuation = 0.05 + 0.25 * np.exp(-5 * progress)
        rx_signal[i + delay_samples] = attenuation * tx_signal[i]
    
    rx_signal += np.random.randn(len(rx_signal)) * 0.01
    
    # Full analysis pipeline
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # 1. Calculate ERL time series
    erl_series = analyzer.calculate_erl_time_series(window_ms=100, overlap_ms=50)
    assert len(erl_series) > 0, "Should get ERL time series"
    
    # 2. Detect convergence
    conv_time, converged = analyzer.estimate_convergence(erl_series, threshold_percent=90)
    assert converged is True, "Should detect convergence"
    assert conv_time is not None, "Convergence time should not be None"
    
    # 3. Calculate residual echo
    residual_echo = analyzer.calculate_residual_echo(delay_samples, conv_time)
    assert residual_echo is not None, "Residual echo should not be None"
    
    # 4. Verify residual echo is reasonable
    assert -50 < residual_echo < -15, \
        f"Residual echo should be reasonable, got {residual_echo:.1f} dBFS"
    
    print("✓ test_calculate_residual_echo_integration passed")


