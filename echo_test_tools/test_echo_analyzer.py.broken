def test_calculate_erle_custom_windows():
    """Test ERLE calculation with custom window sizes."""
    # Create a longer time series
    erl_series = []
    for i in range(50):
        time_ms = i * 100  # Every 100ms
        # ERL improves from 5 dB to 25 dB over 5 seconds
        erl_db = 5 + (20 * i / 49)
        erl_series.append((time_ms, erl_db))
    
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Use smaller windows (200ms each)
    erle = analyzer.calculate_erle(erl_series, early_window_ms=200, late_window_ms=200)
    
    assert erle is not None, "ERLE should not be None for valid data"
    
    # Early window (0-200ms): ERL around 5-6 dB
    # Late window (4700-4900ms): ERL around 24-25 dB
    # ERLE should be around 19 dB
    assert 15 < erle < 22, f"Expected ERLE around 19 dB, got {erle:.1f} dB"
    
    print("✓ test_calculate_erle_custom_windows passed")


def test_calculate_erle_realistic_convergence():
    """Test ERLE with realistic AEC convergence pattern."""
    # Simulate realistic AEC convergence:
    # - Starts at 6 dB (poor)
    # - Converges to 22 dB (good) over ~2 seconds
    # - Stays stable
    erl_series = []
    
    # Early phase (0-500ms): poor ERL around 6-8 dB
    for i in range(5):
        erl_series.append((i * 100, 6 + i * 0.4))
    
    # Convergence phase (500-2000ms): ERL improves rapidly
    for i in range(15):
        time_ms = 500 + i * 100
        erl_db = 8 + (14 * i / 14)  # 8 to 22 dB
        erl_series.append((time_ms, erl_db))
    
    # Stable phase (2000-5000ms): ERL stays at 22 dB
    for i in range(30):
        time_ms = 2000 + i * 100
        erl_series.append((time_ms, 22 + np.random.randn() * 0.5))  # Small noise
    
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    erle = analyzer.calculate_erle(erl_series, early_window_ms=500, late_window_ms=500)
    
    assert erle is not None, "ERLE should not be None for valid data"
    
    # Early average: ~6-8 dB
    # Late average: ~22 dB
    # ERLE should be around 14-16 dB
    assert 12 < erle < 18, f"Expected ERLE around 15 dB, got {erle:.1f} dB"
    
    # This should be classified as "good" AEC performance (ERLE > 6 dB)
    assert erle > 6, "ERLE should indicate good AEC performance"
    
    print("✓ test_calculate_erle_realistic_convergence passed")


def test_calculate_erle_integration_with_time_series():
    """Integration test: calculate ERL time series then ERLE."""
    sample_rate = 8000
    duration_s = 3.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal (sine wave)
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # Create RX signal that simulates AEC convergence:
    # - Early: strong echo (-10 dB)
    # - Late: weak echo (-25 dB)
    delay_samples = 100
    rx_signal = np.zeros_like(tx_signal)
    
    for i in range(len(tx_signal) - delay_samples):
        # Attenuation improves over time
        progress = i / (len(tx_signal) - delay_samples)
        attenuation = 0.3 * (1 - progress) + 0.05 * progress  # 0.3 -> 0.05
        rx_signal[i + delay_samples] = attenuation * tx_signal[i]
    
    # Add small noise
    rx_signal += np.random.randn(len(rx_signal)) * 0.01
    
    # Analyze
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    erl_series = analyzer.calculate_erl_time_series(window_ms=100, overlap_ms=50)
    
    assert len(erl_series) > 0, "Should get ERL time series"
    
    # Calculate ERLE
    erle = analyzer.calculate_erle(erl_series, early_window_ms=500, late_window_ms=500)
    
    assert erle is not None, "ERLE should not be None"
    
    # ERLE should be positive (improvement from early to late)
    assert erle > 0, f"ERLE should be positive, got {erle:.1f} dB"
    
    # With attenuation going from 0.3 (-10.5 dB) to 0.05 (-26 dB),
    # ERLE should be around 15 dB
    assert 10 < erle < 20, f"Expected ERLE around 15 dB, got {erle:.1f} dB"
    
    print("✓ test_calculate_erle_integration_with_time_series passed")


def test_estimate_convergence_basic():
    """Test basic convergence detection with known ERL time series."""
    # Create a time series where ERL converges from 8dB to 24dB
    # Convergence at 90% of 24dB = 21.6dB
    erl_series = [
        (50.0, 8.0),     # Early: 8 dB
        (100.0, 10.0),
        (150.0, 12.0),
        (200.0, 14.0),
        (250.0, 16.0),
        (300.0, 18.0),
        (350.0, 20.0),
        (400.0, 22.0),   # First time >= 21.6 dB (90% of 24)
        (450.0, 23.0),
        (500.0, 24.0),   # Final steady-state
        (550.0, 24.0),
        (600.0, 24.0),
    ]
    
    # Create a dummy analyzer
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Estimate convergence
    conv_time, converged = analyzer.estimate_convergence(erl_series, threshold_percent=90)
    
    assert converged is True, "Should detect convergence"
    assert conv_time is not None, "Convergence time should not be None"
    
    # Convergence should occur around 400ms (when ERL reaches 22dB, which is > 21.6dB)
    assert 350 < conv_time < 450, f"Expected convergence around 400ms, got {conv_time}ms"
    
    print("✓ test_estimate_convergence_basic passed")


def test_estimate_convergence_no_convergence():
    """Test that non-converging ERL series returns (None, False)."""
    # Create a series where ERL improves but has a huge jump at the very end
    # This makes the "final" value much higher than what was achieved during the series
    # Final ERL (last 20%) will be dominated by the last measurement
    # So 90% of final will be higher than all earlier measurements
    erl_series = [
        (50.0, 8.0),
        (100.0, 9.0),
        (150.0, 10.0),
        (200.0, 11.0),
        (250.0, 12.0),
        (300.0, 13.0),
        (350.0, 14.0),
        (400.0, 15.0),
        (450.0, 16.0),
        (500.0, 100.0),   # Huge jump at the very end (unrealistic but tests the logic)
    ]
    
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    conv_time, converged = analyzer.estimate_convergence(erl_series, threshold_percent=90)
    
    # Final steady-state (last 20% = last 2 measurements): avg of 16.0 and 100.0 = 58.0
    # 90% of 58.0 = 52.2
    # The series never reaches 52.2 until the last measurement (100.0)
    # So it should converge at 500ms (the last measurement)
    assert converged is True, "Should detect convergence at the last point"
    assert conv_time == 500.0, f"Should converge at last measurement (500ms), got {conv_time}ms"
    
    print("✓ test_estimate_convergence_no_convergence passed")


