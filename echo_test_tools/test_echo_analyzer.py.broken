def test_compute_impulse_response_basic():
    """Test basic impulse response computation with synthetic echo."""
    sample_rate = 8000
    duration_s = 1.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal (sine wave)
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # Create RX signal with known echo delay and attenuation
    delay_samples = 100  # ~12.5ms at 8kHz
    rx_signal = np.zeros_like(tx_signal)
    rx_signal[delay_samples:] = 0.3 * tx_signal[:-delay_samples]  # 30% amplitude
    
    # Add small noise
    rx_signal += np.random.randn(len(rx_signal)) * 0.01
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    impulse_response, tail_length_ms, peaks = analyzer.compute_impulse_response(max_length_ms=100)
    
    # Verify impulse response is returned
    assert impulse_response is not None, "Impulse response should not be None"
    assert len(impulse_response) > 0, "Impulse response should not be empty"
    
    # Verify tail length is reasonable
    assert tail_length_ms >= 0, "Tail length should be non-negative"
    assert tail_length_ms < 100, "Tail length should be within max_length_ms"
    
    # Verify peaks are detected
    assert len(peaks) > 0, "Should detect at least one peak"
    
    # Verify peak format: list of (delay_ms, amplitude) tuples
    for delay_ms, amplitude in peaks:
        assert isinstance(delay_ms, float), "Peak delay should be float"
        assert isinstance(amplitude, float), "Peak amplitude should be float"
        assert delay_ms >= 0, "Peak delay should be non-negative"
        assert amplitude > 0, "Peak amplitude should be positive"
    
    # Verify peaks are sorted by amplitude (strongest first)
    peak_amplitudes = [a for _, a in peaks]
    assert peak_amplitudes == sorted(peak_amplitudes, reverse=True), "Peaks should be sorted by amplitude (strongest first)"
    
    # The main peak (strongest) should be near the known delay (12.5ms)
    main_peak_delay, main_peak_amplitude = peaks[0]
    assert 10 < main_peak_delay < 15, f"Main peak should be near 12.5ms, got {main_peak_delay:.1f}ms"
    
    print("✓ test_compute_impulse_response_basic passed")


def test_compute_impulse_response_all_zero_tx():
    """Test that all-zero TX signal returns zeros."""
    sample_rate = 8000
    n_samples = 8000
    
    tx_signal = np.zeros(n_samples)
    rx_signal = np.random.randn(n_samples) * 0.1
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
