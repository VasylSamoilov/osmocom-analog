#!/usr/bin/env python3
"""
Unit tests for echo_analyzer.py

Tests the EfficiencyMeasurement dataclass and its serialization methods.
"""

import json
import numpy as np
from echo_analyzer import EfficiencyMeasurement, EchoAnalyzer


def test_efficiency_measurement_to_dict():
    """Test that EfficiencyMeasurement.to_dict() includes all fields."""
    measurement = EfficiencyMeasurement(
        # Base metrics
        delay_samples=100,
        delay_ms=12.5,
        correlation_peak=0.872,
        tx_power_dbfs=-6.2,
        rx_power_dbfs=-18.4,
        noise_floor_dbfs=-52.3,
        erl_db=12.2,
        snr_db=33.9,
        sample_rate=8000,
        
        # Efficiency metrics
        erle_db=16.1,
        convergence_time_ms=850.0,
        residual_echo_dbfs=-42.5,
        
        # Debug data
        erl_time_series=[(50.0, 8.2), (100.0, 10.5), (150.0, 14.2)],
        echo_impulse_response=[0.0, 0.0, 0.85, 0.12],
        echo_tail_length_ms=35.2,
        echo_peaks=[(12.5, 0.85), (45.2, 0.23)],
        echo_frequency_response=[(100.0, -12.3), (200.0, -11.8)],
        
        # Quality flags
        aec_performance="good",
        converged=True
    )
    
    result = measurement.to_dict()
    
    # Verify all base metrics are present
    assert result["delay_samples"] == 100
    assert result["delay_ms"] == 12.5
    assert result["correlation_peak"] == 0.872
    assert result["tx_power_dbfs"] == -6.2
    assert result["rx_power_dbfs"] == -18.4
    assert result["noise_floor_dbfs"] == -52.3
    assert result["erl_db"] == 12.2
    assert result["snr_db"] == 33.9
    assert result["sample_rate"] == 8000
    
    # Verify efficiency metrics
    assert result["erle_db"] == 16.1
    assert result["convergence_time_ms"] == 850.0
    assert result["residual_echo_dbfs"] == -42.5
    
    # Verify debug data
    assert result["erl_time_series"] == [(50.0, 8.2), (100.0, 10.5), (150.0, 14.2)]
    assert result["echo_impulse_response"] == [0.0, 0.0, 0.85, 0.12]
    assert result["echo_tail_length_ms"] == 35.2
    assert result["echo_peaks"] == [(12.5, 0.85), (45.2, 0.23)]
    assert result["echo_frequency_response"] == [(100.0, -12.3), (200.0, -11.8)]
    
    # Verify quality flags
    assert result["aec_performance"] == "good"
    assert result["converged"] is True
    print("✓ test_efficiency_measurement_to_dict passed")


def test_efficiency_measurement_from_dict():
    """Test that EfficiencyMeasurement.from_dict() correctly deserializes."""
    data = {
        # Base metrics
        "delay_samples": 100,
        "delay_ms": 12.5,
        "correlation_peak": 0.872,
        "tx_power_dbfs": -6.2,
        "rx_power_dbfs": -18.4,
        "noise_floor_dbfs": -52.3,
        "erl_db": 12.2,
        "snr_db": 33.9,
        "sample_rate": 8000,
        
        # Efficiency metrics
        "erle_db": 16.1,
        "convergence_time_ms": 850.0,
        "residual_echo_dbfs": -42.5,
        
        # Debug data
        "erl_time_series": [[50.0, 8.2], [100.0, 10.5], [150.0, 14.2]],
        "echo_impulse_response": [0.0, 0.0, 0.85, 0.12],
        "echo_tail_length_ms": 35.2,
        "echo_peaks": [[12.5, 0.85], [45.2, 0.23]],
        "echo_frequency_response": [[100.0, -12.3], [200.0, -11.8]],
        
        # Quality flags
        "aec_performance": "good",
        "converged": True
    }
    
    measurement = EfficiencyMeasurement.from_dict(data)
    
    # Verify all fields are correctly deserialized
    assert measurement.delay_samples == 100
    assert measurement.delay_ms == 12.5
    assert measurement.correlation_peak == 0.872
    assert measurement.erle_db == 16.1
    assert measurement.convergence_time_ms == 850.0
    assert measurement.aec_performance == "good"
    assert measurement.converged is True
    print("✓ test_efficiency_measurement_from_dict passed")


def test_efficiency_measurement_round_trip():
    """Test that serialization and deserialization are inverses."""
    original = EfficiencyMeasurement(
        # Base metrics
        delay_samples=100,
        delay_ms=12.5,
        correlation_peak=0.872,
        tx_power_dbfs=-6.2,
        rx_power_dbfs=-18.4,
        noise_floor_dbfs=-52.3,
        erl_db=12.2,
        snr_db=33.9,
        sample_rate=8000,
        
        # Efficiency metrics
        erle_db=16.1,
        convergence_time_ms=850.0,
        residual_echo_dbfs=-42.5,
        
        # Debug data
        erl_time_series=[(50.0, 8.2), (100.0, 10.5)],
        echo_impulse_response=[0.0, 0.85],
        echo_tail_length_ms=35.2,
        echo_peaks=[(12.5, 0.85)],
        echo_frequency_response=[(100.0, -12.3)],
        
        # Quality flags
        aec_performance="good",
        converged=True
    )
    
    # Round trip: object -> dict -> object
    reconstructed = EfficiencyMeasurement.from_dict(original.to_dict())
    
    # Verify all fields match
    assert reconstructed.delay_samples == original.delay_samples
    assert reconstructed.delay_ms == original.delay_ms
    assert reconstructed.correlation_peak == original.correlation_peak
    assert reconstructed.tx_power_dbfs == original.tx_power_dbfs
    assert reconstructed.rx_power_dbfs == original.rx_power_dbfs
    assert reconstructed.noise_floor_dbfs == original.noise_floor_dbfs
    assert reconstructed.erl_db == original.erl_db
    assert reconstructed.snr_db == original.snr_db
    assert reconstructed.sample_rate == original.sample_rate
    assert reconstructed.erle_db == original.erle_db
    assert reconstructed.convergence_time_ms == original.convergence_time_ms
    assert reconstructed.residual_echo_dbfs == original.residual_echo_dbfs
    assert reconstructed.erl_time_series == original.erl_time_series
    assert reconstructed.echo_impulse_response == original.echo_impulse_response
    assert reconstructed.echo_tail_length_ms == original.echo_tail_length_ms
    assert reconstructed.echo_peaks == original.echo_peaks
    assert reconstructed.echo_frequency_response == original.echo_frequency_response
    assert reconstructed.aec_performance == original.aec_performance
    assert reconstructed.converged == original.converged
    print("✓ test_efficiency_measurement_round_trip passed")


def test_efficiency_measurement_with_none_values():
    """Test that None values are handled correctly in serialization."""
    measurement = EfficiencyMeasurement(
        # Base metrics
        delay_samples=100,
        delay_ms=12.5,
        correlation_peak=0.872,
        tx_power_dbfs=-6.2,
        rx_power_dbfs=-18.4,
        noise_floor_dbfs=-52.3,
        erl_db=12.2,
        snr_db=33.9,
        sample_rate=8000,
        
        # Efficiency metrics (all None)
        erle_db=None,
        convergence_time_ms=None,
        residual_echo_dbfs=None,
        
        # Debug data (some None)
        erl_time_series=[],
        echo_impulse_response=None,
        echo_tail_length_ms=None,
        echo_peaks=[],
        echo_frequency_response=None,
        
        # Quality flags
        aec_performance="poor",
        converged=False
    )
    
    result = measurement.to_dict()
    
    # Verify None values are preserved
    assert result["erle_db"] is None
    assert result["convergence_time_ms"] is None
    assert result["residual_echo_dbfs"] is None
    assert result["echo_impulse_response"] is None
    assert result["echo_tail_length_ms"] is None
    assert result["echo_frequency_response"] is None
    
    # Verify round trip with None values
    reconstructed = EfficiencyMeasurement.from_dict(result)
    assert reconstructed.erle_db is None
    assert reconstructed.convergence_time_ms is None
    assert reconstructed.residual_echo_dbfs is None
    print("✓ test_efficiency_measurement_with_none_values passed")


def test_efficiency_measurement_to_json():
    """Test that to_json() produces valid JSON."""
    measurement = EfficiencyMeasurement(
        # Base metrics
        delay_samples=100,
        delay_ms=12.5,
        correlation_peak=0.872,
        tx_power_dbfs=-6.2,
        rx_power_dbfs=-18.4,
        noise_floor_dbfs=-52.3,
        erl_db=12.2,
        snr_db=33.9,
        sample_rate=8000,
        
        # Efficiency metrics
        erle_db=16.1,
        convergence_time_ms=850.0,
        residual_echo_dbfs=-42.5,
        
        # Debug data
        erl_time_series=[(50.0, 8.2)],
        echo_impulse_response=[0.0, 0.85],
        echo_tail_length_ms=35.2,
        echo_peaks=[(12.5, 0.85)],
        echo_frequency_response=[(100.0, -12.3)],
        
        # Quality flags
        aec_performance="good",
        converged=True
    )
    
    json_str = measurement.to_json()
    
    # Verify it's valid JSON
    parsed = json.loads(json_str)
    assert parsed["delay_samples"] == 100
    assert parsed["erle_db"] == 16.1
    assert parsed["aec_performance"] == "good"
    print("✓ test_efficiency_measurement_to_json passed")


def test_calculate_erl_time_series_basic():
    """Test basic ERL time series calculation with synthetic signals."""
    sample_rate = 8000
    duration_s = 1.0
    n_samples = int(sample_rate * duration_s)
    
    # Create a simple test signal (sine wave)
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)  # 440 Hz tone
    
    # Create RX signal as attenuated and delayed version of TX
    delay_samples = 100  # ~12.5ms at 8kHz
    rx_signal = np.zeros_like(tx_signal)
    rx_signal[delay_samples:] = 0.1 * tx_signal[:-delay_samples]  # -20dB attenuation
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    erl_series = analyzer.calculate_erl_time_series(window_ms=100, overlap_ms=50)
    
    # Verify we got results
    assert len(erl_series) > 0, "Should return non-empty time series"
    
    # Verify format: list of (time_ms, erl_db) tuples
    for time_ms, erl_db in erl_series:
        assert isinstance(time_ms, float), "Time should be float"
        assert isinstance(erl_db, (float, int)), "ERL should be numeric"
        assert time_ms >= 0, "Time should be non-negative"
    
    # Verify time series is sorted
    times = [t for t, _ in erl_series]
    assert times == sorted(times), "Time series should be sorted"
    
    # Verify ERL values are reasonable (should be around 20dB for -20dB attenuation)
    erl_values = [erl for _, erl in erl_series]
    avg_erl = np.mean(erl_values)
    assert 15 < avg_erl < 25, f"Expected ERL around 20dB, got {avg_erl:.1f}dB"
    
    print("✓ test_calculate_erl_time_series_basic passed")


def test_calculate_erl_time_series_short_signal():
    """Test that short signals return empty list."""
    sample_rate = 8000
    # Create signal shorter than default window (100ms = 800 samples)
    tx_signal = np.random.randn(500)
    rx_signal = np.random.randn(500)
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    erl_series = analyzer.calculate_erl_time_series(window_ms=100, overlap_ms=50)
    
    # Should return empty list for short signals
    assert len(erl_series) == 0, "Short signals should return empty list"
    print("✓ test_calculate_erl_time_series_short_signal passed")


def test_calculate_erl_time_series_all_zero_tx():
    """Test that all-zero TX signal returns empty list."""
    sample_rate = 8000
    n_samples = 8000  # 1 second
    
    tx_signal = np.zeros(n_samples)
    rx_signal = np.random.randn(n_samples) * 0.1
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    erl_series = analyzer.calculate_erl_time_series(window_ms=100, overlap_ms=50)
    
    # Should return empty list for all-zero TX
    assert len(erl_series) == 0, "All-zero TX should return empty list"
    print("✓ test_calculate_erl_time_series_all_zero_tx passed")


def test_calculate_erl_time_series_all_zero_rx():
    """Test that all-zero RX signal returns high ERL values."""
    sample_rate = 8000
    duration_s = 1.0
    n_samples = int(sample_rate * duration_s)
    
    # Create TX signal
    t = np.linspace(0, duration_s, n_samples)
    tx_signal = 0.5 * np.sin(2 * np.pi * 440 * t)
    
    # RX is all zeros (no echo)
    rx_signal = np.zeros(n_samples)
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    erl_series = analyzer.calculate_erl_time_series(window_ms=100, overlap_ms=50)
    
    # Should return results with very high ERL (no echo = infinite attenuation)
    assert len(erl_series) > 0, "Should return time series even with zero RX"
    
    # ERL values should be very high (approaching the -100dBFS floor)
    erl_values = [erl for _, erl in erl_series]
    avg_erl = np.mean(erl_values)
    assert avg_erl > 80, f"Expected very high ERL for zero RX, got {avg_erl:.1f}dB"
    
    print("✓ test_calculate_erl_time_series_all_zero_rx passed")


def test_calculate_erl_time_series_coverage():
    """Test that time series covers the full signal duration."""
    sample_rate = 8000
    duration_s = 2.0
    n_samples = int(sample_rate * duration_s)
    
    # Create test signals
    tx_signal = np.random.randn(n_samples) * 0.5
    rx_signal = np.random.randn(n_samples) * 0.1
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    window_ms = 100
    overlap_ms = 50
    erl_series = analyzer.calculate_erl_time_series(window_ms=window_ms, overlap_ms=overlap_ms)
    
    # Verify coverage
    assert len(erl_series) > 0, "Should return non-empty time series"
    
    times = [t for t, _ in erl_series]
    min_time = min(times)
    max_time = max(times)
    
    # First measurement should be near the start
    assert min_time < window_ms, f"First measurement at {min_time}ms should be near start"
    
    # Last measurement should cover a significant portion of the signal
    # (it won't reach the very end because we need a full window and account for delay)
    duration_ms = duration_s * 1000
    # Relaxed threshold to 70% since delay estimation can reduce coverage
    assert max_time > duration_ms * 0.7, f"Last measurement at {max_time}ms should cover most of signal ({duration_ms}ms)"
    
    # Check spacing between measurements
    step_ms = window_ms - overlap_ms
    if len(times) > 1:
        gaps = [times[i+1] - times[i] for i in range(len(times)-1)]
        avg_gap = np.mean(gaps)
        # Gap should be approximately equal to step size
        assert abs(avg_gap - step_ms) < 10, f"Average gap {avg_gap:.1f}ms should be close to step {step_ms}ms"
    
    print("✓ test_calculate_erl_time_series_coverage passed")


def test_calculate_erl_time_series_custom_params():
    """Test with custom window and overlap parameters."""
    sample_rate = 8000
    duration_s = 1.0
    n_samples = int(sample_rate * duration_s)
    
    tx_signal = np.random.randn(n_samples) * 0.5
    rx_signal = np.random.randn(n_samples) * 0.1
    
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Test with larger window and overlap
    erl_series = analyzer.calculate_erl_time_series(window_ms=200, overlap_ms=100)
    
    assert len(erl_series) > 0, "Should return results with custom parameters"
    
    # With 200ms window and 100ms overlap, step is 100ms
    # For 1 second signal, we should get several measurements
    # (fewer than expected due to delay estimation reducing available length)
    assert 3 < len(erl_series) < 15, f"Expected several measurements, got {len(erl_series)}"
    
    print("✓ test_calculate_erl_time_series_custom_params passed")


def test_calculate_erle_basic():
    """Test basic ERLE calculation with known ERL time series."""
    # Create a time series where ERL improves from 8dB to 24dB
    # This simulates AEC convergence
    erl_series = [
        (50.0, 8.0),    # Early: 8 dB
        (100.0, 9.0),
        (150.0, 10.0),
        (200.0, 12.0),
        (250.0, 14.0),
        (500.0, 18.0),
        (750.0, 20.0),
        (1000.0, 22.0),
        (1250.0, 23.0),
        (1500.0, 24.0),  # Late: 24 dB
        (1750.0, 24.0),
        (2000.0, 24.0),
    ]
    
    # Create a dummy analyzer (we only need the method, not the signals)
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    # Calculate ERLE with 500ms windows
    erle = analyzer.calculate_erle(erl_series, early_window_ms=500, late_window_ms=500)
    
    assert erle is not None, "ERLE should not be None for valid data"
    
    # Early window (0-500ms): average of 8, 9, 10, 12, 14, 18 = ~11.8 dB
    # Late window (1500-2000ms): average of 24, 24, 24 = 24 dB
    # ERLE = 24 - 11.8 = ~12.2 dB
    assert 10 < erle < 15, f"Expected ERLE around 12 dB, got {erle:.1f} dB"
    
    # ERLE should be positive (improvement)
    assert erle > 0, "ERLE should be positive for improving ERL"
    
    print("✓ test_calculate_erle_basic passed")


def test_calculate_erle_no_improvement():
    """Test ERLE calculation when ERL doesn't improve (no AEC)."""
    # Flat ERL time series (no convergence)
    erl_series = [
        (50.0, 10.0),
        (100.0, 10.5),
        (150.0, 9.8),
        (200.0, 10.2),
        (500.0, 10.1),
        (750.0, 9.9),
        (1000.0, 10.3),
        (1500.0, 10.0),
        (2000.0, 10.1),
    ]
    
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    erle = analyzer.calculate_erle(erl_series, early_window_ms=500, late_window_ms=500)
    
    assert erle is not None, "ERLE should not be None for valid data"
    
    # ERLE should be close to 0 (no improvement)
    assert -2 < erle < 2, f"Expected ERLE near 0 dB for flat ERL, got {erle:.1f} dB"
    
    print("✓ test_calculate_erle_no_improvement passed")


def test_calculate_erle_degradation():
    """Test ERLE calculation when ERL degrades (negative ERLE)."""
    # ERL gets worse over time (unusual but possible)
    erl_series = [
        (50.0, 20.0),   # Early: good ERL
        (100.0, 19.0),
        (150.0, 18.0),
        (200.0, 16.0),
        (500.0, 14.0),
        (750.0, 12.0),
        (1000.0, 10.0),
        (1500.0, 8.0),  # Late: poor ERL
        (2000.0, 8.0),
    ]
    
    sample_rate = 8000
    tx_signal = np.zeros(100)
    rx_signal = np.zeros(100)
    analyzer = EchoAnalyzer(tx_signal, rx_signal, sample_rate)
    
    erle = analyzer.calculate_erle(erl_series, early_window_ms=500, late_window_ms=500)
    
    assert erle is not None, "ERLE should not be None for valid data"
    
    # ERLE should be negative (degradation)
    assert erle < 0, f"Expected negative ERLE for degrading ERL, got {erle:.1f} dB"
    
    print("✓ test_calculate_erle_degradation passed")


