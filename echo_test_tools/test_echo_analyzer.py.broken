    assert np.max(np.abs(impulse_response)) < 1e-10, "Impulse response should be all zeros"
    assert tail_length_ms == 0.0, "Tail length should be 0"
    assert len(peaks) == 0, "Should not detect any peaks"
    
    print("✓ test_compute_impulse_response_all_zero_tx passed")


